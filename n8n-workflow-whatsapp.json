{
  "name": "Disparo em Lote WhatsApp + IA (Intervalos)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "disparo-lote-whatsapp",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.isAiEnabled }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Usar IA?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "resource": "image",
        "operation": "generate",
        "prompt": "={{ $json.body.aiPrompt }}",
        "size": "1024x1024",
        "responseFormat": "b64_json"
      },
      "name": "Gerar Imagem (OpenAI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "prompt": "Crie uma mensagem persuasiva baseada neste pedido: {{ $('Webhook').item.json.body.aiPrompt }}",
        "model": "gpt-4o"
      },
      "name": "Gerar Texto (OpenAI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        600,
        200
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "finalText",
              "value": "={{ $json.text }}"
            },
            {
              "name": "finalImage",
              "value": "={{ $('Gerar Imagem (OpenAI)').item.json.data[0].b64_json }}"
            },
            {
              "name": "intervalMinutes",
              "value": "={{ $('Webhook').item.json.body.body.intervalMinutes }}"
            },
            {
              "name": "recurringDays",
              "value": "={{ $('Webhook').item.json.body.body.recurringDays }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set IA Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        800,
        150
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "finalText",
              "value": "={{ $json.body.body.messageText }}"
            },
            {
              "name": "finalImage",
              "value": "={{ $json.body.body.image?.base64 || '' }}"
            },
            {
              "name": "intervalMinutes",
              "value": "={{ $json.body.body.intervalMinutes }}"
            },
            {
              "name": "recurringDays",
              "value": "={{ $json.body.body.recurringDays }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Manual Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        800,
        450
      ]
    },
    {
      "parameters": {},
      "name": "Consolidar Dados",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "SUA_PLANILHA_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Página1",
          "mode": "name"
        },
        "options": {}
      },
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1600,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://SUA_EVOLUTION_API/message/sendMedia/' + 'NOME_DA_INSTANCIA' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.telefone }}"
            },
            {
              "name": "mediatype",
              "value": "image"
            },
            {
              "name": "media",
              "value": "={{ $('Consolidar Dados').item.json.finalImage }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Consolidar Dados').item.json.finalText }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Evolution API (Disparo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ $('Consolidar Dados').item.json.intervalMinutes || 10 }}",
        "unit": "minutes"
      },
      "name": "Wait (Aguardar Intervalo)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const days = $input.first().json.recurringDays || 1;\nconst result = [];\nfor (let i = 0; i < days; i++) {\n  result.push({\n    json: {\n      ...$input.first().json,\n      dayIndex: i + 1\n    }\n  });\n}\nreturn result;"
      },
      "name": "Gerar Dias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Loop Diário",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "days"
      },
      "name": "Wait Diário",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        2050,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $('Loop Diário').item.json.dayIndex }}",
              "operation": "smaller",
              "value2": "={{ $('Consolidar Dados').item.json.recurringDays }}"
            }
          ]
        }
      },
      "name": "Checar Último Dia",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1850,
        500
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Usar IA?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Usar IA?": {
      "main": [
        [
          {
            "node": "Gerar Imagem (OpenAI)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set Manual Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar Imagem (OpenAI)": {
      "main": [
        [
          {
            "node": "Gerar Texto (OpenAI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar Texto (OpenAI)": {
      "main": [
        [
          {
            "node": "Set IA Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set IA Data": {
      "main": [
        [
          {
            "node": "Consolidar Dados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Manual Data": {
      "main": [
        [
          {
            "node": "Consolidar Dados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop": {
      "main": [
        [
          {
            "node": "Evolution API (Disparo)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Checar Último Dia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evolution API (Disparo)": {
      "main": [
        [
          {
            "node": "Wait (Aguardar Intervalo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait (Aguardar Intervalo)": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consolidar Dados": {
      "main": [
        [
          {
            "node": "Gerar Dias",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar Dias": {
      "main": [
        [
          {
            "node": "Loop Diário",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Diário": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Wait Diário": {
      "main": [
        [
          {
            "node": "Loop Diário",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checar Último Dia": {
      "main": [
        [
          {
            "node": "Wait Diário",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}